# Salin file ini jadi `.env` lalu isi nilainya. Jangan commit `.env`.

# --- OpenRouter: LLM, embedding, dan reranker ---
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=openai/text-embedding-3-small
RERANK_MODEL=qwen/qwen3-reranker-8b

# --- Qdrant Cloud: vector database ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=imdb_movies

# --- Langfuse: prompt + observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_SUPERVISOR=imdb-supervisor
LANGFUSE_PROMPT_SQL=imdb-sql-agent
LANGFUSE_PROMPT_ANSWER=imdb-answer-agent

# --- Batas biaya (USD) per sesi Streamlit; refresh halaman untuk reset ---
LIMIT_USD=0.001
