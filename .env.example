# Salin file ini menjadi .env lalu isi dengan kredensialmu.
# Jangan commit file .env ke Git.

OPENROUTER_API_KEY=sk-or-v1-...

LLM_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=openai/text-embedding-3-small
Rerank_MODEL=qwen/qwen3-reranker-8b

QDRANT_URL=https://xxx.eu-west-2-0.aws.cloud.qdrant.io
QDRANT_API_KEY=...
QDRANT_COLLECTION=imdb_movies

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://jp.cloud.langfuse.com

# Batas biaya (USD) per sesi; chatbot berhenti kalau sudah lewat, refresh untuk reset.
LIMIT_USD=0.001

# Opsional: nama prompt & label di Langfuse.
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_SUPERVISOR=imdb-supervisor
LANGFUSE_PROMPT_SQL=imdb-sql-agent
LANGFUSE_PROMPT_ANSWER=imdb-answer-agent
